{
    "name": "kent013/laravel-prism-prompt",
    "description": "Laravel Mailable-like API for LLM prompts with Prism",
    "type": "library",
    "version": "0.19.0",
    "license": "MIT",
    "authors": [
        {
            "name": "kent013"
        }
    ],
    "require": {
        "php": "^8.2",
        "echolabsdev/prism": "^0.10|^0.99|^0.100|^1.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0",
        "react/async": "^4.3",
        "symfony/yaml": "^6.0|^7.0|^8.0",
        "webmozart/assert": "^1.11|^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.0|^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0"
    },
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse",
        "fix": "pint"
    },
    "autoload": {
        "psr-4": {
            "Kent013\\PrismPrompt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kent013\\PrismPrompt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kent013\\PrismPrompt\\PromptServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
